<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend partner form view -->
    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.student.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Declare fields first -->
            <field name="category_id" position="before">
                <field name="student_type_change_pending" invisible="1"/>
                <field name="student_type_attachment_filename" invisible="1"/>
                <field name="student_type_change_date" invisible="1"/>
                <field name="student_type_changed_by" invisible="1"/>
            </field>

            <!-- Add student_type after category_id -->
            <xpath expr="//field[@name='category_id']" position="after">
                <group string="Student Information" name="student_group">
                    <group>
                        <field name="student_type" 
                               options="{'no_create': True, 'no_create_edit': True}"
                               class="oe_inline"
                               attrs="{'required': [('student_type_change_pending', '=', True)]}"/>
                        
                        <field name="previous_student_type" 
                               attrs="{'invisible': [('previous_student_type', '=', False)]}"/>
                    </group>
                    <group>
                        <field name="student_type_change_date" 
                               attrs="{'invisible': [('student_type_change_date', '=', False)]}"/>
                        <field name="student_type_changed_by" 
                               attrs="{'invisible': [('student_type_changed_by', '=', False)]}"/>
                    </group>
                </group>
            </xpath>

            <!-- Add warning message -->
            <xpath expr="//field[@name='category_id']" position="after">
                <div class="alert alert-info" 
                     style="margin-top: 10px; margin-bottom: 10px;"
                     attrs="{'invisible': [('student_type_change_pending', '!=', True)]}">
                    <i class="fa fa-info-circle" style="margin-right: 8px;"/>
                    <strong>تنبيه مهم:</strong> 
                    <span style="color: #8a6d3b;">
                        يجب رفع كتاب رسمي (كتاب رسمي) لتأكيد تغيير نوع الطالب.
                        <br/>
                        <small>Official letter is required to confirm student type change.</small>
                    </span>
                </div>
            </xpath>

            <!-- Add attachment field -->
            <xpath expr="//field[@name='category_id']" position="after">
                <label for="student_type_attachment" 
                       string="Official Letter (كتاب رسمي)"
                       class="oe_inline"
                       attrs="{'invisible': [('student_type_change_pending', '!=', True)]}"/>
                <field name="student_type_attachment" 
                       filename="student_type_attachment_filename"
                       widget="binary"
                       class="oe_inline"
                       attrs="{'required': [('student_type_change_pending', '=', True)]}"/>
            </xpath>

            <!-- Add buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_request_attachment" 
                        string="Upload Official Letter" 
                        type="object" 
                        class="btn btn-warning" 
                        attrs="{'invisible': [('student_type_change_pending', '!=', True)]}"/>
                <button name="action_clear_pending_change" 
                        string="Clear Pending Change" 
                        type="object" 
                        class="btn btn-success" 
                        groups="base.group_system" 
                        attrs="{'invisible': [('student_type_change_pending', '!=', True)]}"/>
            </xpath>
        </field>
    </record>

    <!-- Add tree view columns - Fixed version -->
    <record id="view_partner_tree_inherit" model="ir.ui.view">
        <field name="name">res.partner.tree.inherit.student.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <!-- Add fields after the existing fields in the tree view -->
            <field name="display_name" position="after">
                <field name="student_type" widget="many2one"/>
                <field name="student_type_change_pending" 
                       widget="boolean_button" 
                       string="Pending"/>
                <field name="student_type_change_date"/>
            </field>
        </field>
    </record>

    <!-- Add search filters -->
    

    <!-- Kanban view for partners -->
    <record id="view_partner_kanban_inherit" model="ir.ui.view">
        <field name="name">res.partner.kanban.inherit.student.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_kanban_global_click']" position="inside">
                <field name="student_type_change_pending" invisible="1"/>
                <div class="oe_kanban_details">
                    <field name="student_type" readonly="1"/>
                    <div attrs="{'invisible': [('student_type_change_pending', '!=', True)]}">
                        <span class="badge badge-warning">
                            <i class="fa fa-exclamation-triangle"/>
                            <span>Pending</span>
                        </span>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>