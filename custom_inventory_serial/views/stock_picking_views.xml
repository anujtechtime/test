<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_serial_prefix" model="ir.ui.view">
        <field name="name">stock.picking.form.serial.prefix</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
        <xpath expr="//button[@name='button_validate']" position="after">

                <button
                    name="action_generate_serial_prefix"
                    type="object"
                    string="Generate Serial"
                    class="oe_highlight"
                    attrs="{
                        'invisible': [
                            '|',
                            ('picking_type_code', '!=', 'internal'),
                            ('state', '=', 'cancel')
                        ]
                    }"
                />

            </xpath>
            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="serial_prefix_generated" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
