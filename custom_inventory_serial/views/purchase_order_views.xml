<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_excel_import" model="ir.ui.view">
        <field name="name">purchase.order.form.excel.import</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_purchase_order_excel_import)d"
                        string="Import Excel Lines"
                        type="action"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', 'not in', ['draft', 'sent'])]}"/>
            </xpath>
        </field>
    </record>
</odoo>
