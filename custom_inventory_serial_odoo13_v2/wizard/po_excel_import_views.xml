<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_excel_import_form" model="ir.ui.view">
        <field name="name">purchase.order.excel.import.form</field>
        <field name="model">purchase.order.excel.import</field>
        <field name="arch" type="xml">
            <form string="Import Purchase Order Excel">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window id="action_purchase_order_excel_import"
                name="Import Purchase Order Excel"
                res_model="purchase.order.excel.import"
                view_mode="form"
                target="new"/>
</odoo>
