<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_location_form_prefix" model="ir.ui.view">
        <field name="name">stock.location.form.prefix</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="after">
                <field name="building_code"/>
                <field name="floor_code"/>
                <field name="hall_code"/>
                <field name="location_prefix" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
